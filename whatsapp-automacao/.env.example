# Copie para .env e preencha. Variáveis aqui têm prioridade sobre o painel.

# Painel
PORT=3000
# 127.0.0.1 = só nesta máquina. Use 0.0.0.0 na VPS/Docker (com senha!).
HOST=127.0.0.1
PANEL_USER=admin
PANEL_PASSWORD=
# Fuso do negócio (agenda e horário do agente)
TZ=America/Sao_Paulo

# IA — use uma das duas
# Google Gemini (tem cota gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (pago, qualquer modelo): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API oficial da Meta (WhatsApp Cloud API) — developers.facebook.com
WA_CLOUD_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Instagram Direct (API oficial) — developers.facebook.com
IG_ACCESS_TOKEN=
IG_VERIFY_TOKEN=
IG_APP_SECRET=

# Avançado
# DATA_DIR=./data
# LOG_LEVEL=silent
